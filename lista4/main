#include <stdio.h>
#include <stdlib.h>
#include "vetor.h"

int main()
{
    vetor v = {NULL, 0, 0};
    int valor, x0 = 3, x1 = 50;

    for(int i = 0; i < 8; i++){
        printf("Digite um  valor para o vetor\n");
        scanf("%d", &valor);
        append(&v, valor);
    }
    printf("Abaixo estão todos os elementos do vetor\n");
    show(v);

    printf("Abaixo apenas os elementos do vetor dentro do intervalo (%d, %d)\n", x0, x1);
    show(*slice(v, x0, x1));

    printf("Abaixo o vetor sem o ultimo elemento\n");
    pop(&v);
    show(v);

    return 0;
}
