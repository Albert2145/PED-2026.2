#include <stdio.h>
#include <stdlib.h>
#include "vetor.h"

void append(vetor *v, int valor){
    if(v->tamanho_alocado == 0 && v->tamanho_ocupado == 0){
        v->tamanho_alocado = 2;
        v->dados =(int *) malloc(v->tamanho_alocado*sizeof(int));
        if(v->dados == NULL){
            printf("Não consegui alocar");
            exit(1);
    }

    if(v->tamanho_ocupado == v->tamanho_alocado){
        v->dados =(int *) realloc(v->dados,(v->tamanho_alocado*2)*sizeof(int));
        v->tamanho_alocado *= 2;
    }
    //adiciona o valor ao vetor
    *(v->dados + v->tamanho_ocupado) = valor;

    v->tamanho_ocupado++;
}


void show(vetor v){
    for(int i = 0; i < v.tamanho_ocupado; i++){
            printf("%d\n", *(v.dados+i));
    } 
}


vetor *slice(vetor v, int x0, int x1){
    vetor *novo = (vetor *) malloc(sizeof(vetor));

    int j = 0;
    for(int i = 0; i < v.tamanho_ocupado; i++){
        if(*(v.dados+i) >= x0 && *(v.dados+i) <= x1){
            j++;
        }
    }
    novo->tamanho_alocado = j;
    novo->tamanho_ocupado = j;
    novo->dados = (int *) malloc(novo->tamanho_alocado*sizeof(int));

    int k = 0;
    for(int i = 0; i < v.tamanho_ocupado; i++ ){
        if(*(v.dados+i) >= x0 && *(v.dados+i) <= x1){
            *(novo->dados+k) = *(v.dados+i);
            k++;
        }
    }
    return novo;
}


void pop(vetor *v){
    if(v->tamanho_ocupado > 0){
        v->tamanho_ocupado--;
    }
}
