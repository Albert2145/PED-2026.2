#include <stdio.h>
#include <stdlib.h>
#include <time.h>
int main()
{
    //Questao 3.9
    srand(time(NULL));

    int saida1 = rand() % 10;
    int saida2 = rand() % 10;
    int saida3 = rand() % 10;
    int palp1, palp2, palp3, i;
    char resp1, resp2, resp3;
    //Precisei pesquisar como gerar numeros aleatórios em C 

    for(i = 1; i <= 10; i++){
        resp1='_';
        resp2='_';
        resp3='_';
        printf("==== Chance %d ====\n", i);
        printf("Palpite: ");
        scanf("%d %d %d", &palp1, &palp2, &palp3);

        if (palp1 == saida1){
            resp1 = '+';
        }        
        else if (palp1 == saida2 || palp1 == saida3){
            resp1 = '!';
        }

        if (palp2 == saida2){
            resp2 = '+';
        }
        else if (palp2 == saida1 || palp2 == saida3){
            resp2 = '!';
        }
    
        if (palp3 == saida3){
            resp3 = '+';
        }
        else if (palp3 == saida1 || palp3 == saida2){
            resp3 = '!';
        }
        

        printf("Saída: %c %c %c\n", resp1, resp2, resp3);
 
        if (resp1 == '+' && resp2 == '+' && resp3 == '+') {
            printf("Parabéns! Você acertou!\n");
            return 0;
        }
    }
 
    printf("Suas chances acabaram. O número secreto era %d%d%d\n", saida1, saida2, saida3);
 
    return 0;
}
