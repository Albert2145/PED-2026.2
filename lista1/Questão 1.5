#include <stdio.h>
#include <stdlib.h>
#include <math.h>

int main()
{
    //Questão 1.5
    int seg, min, horas;
    
    printf("Digite os segundos.\n");
    scanf("%d", &seg);
    
    horas = seg / 3600;
    seg = seg % 3600;
    min = seg / 60;
    seg = seg % 60;
    
    printf("%dh %dmins %ds", horas, min, seg);
    return 0;
}
