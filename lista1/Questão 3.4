#include <stdio.h>
int main()
{
    //Questao 3.4
    int num, par, i;

    printf("Digite um número inteiro.\n");
    scanf("%d", &num);

    for(i = 1; i <= num; i++){
        if(i % 2 == 0){
            par += 1;
        }
    }
    
    printf("Existem %d números pares entre 1 e %d", par, num);

    return 0;
}
