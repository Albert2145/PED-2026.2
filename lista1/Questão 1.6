#include <stdio.h>
#include <stdlib.h>
#include <math.h>

int main()
{
    //Questão 1.6
    
    int kmL, distancia, pessoas;
    float gasolina;
    
    printf("Vamos calcular o custo da viagem!\n");

    printf("Quantos quilômetros seu carro percorre por litro de combustível?\n");
    scanf("%d", &kmL);
    
    printf("Quantos quilômetros você pretende viajar de carro?\n");
    scanf("%d", &distancia);
    
    printf("Qual o preço do combustivel onde você abastece?\n");
    scanf("%f", &gasolina);
    
    printf("Quantas pessoas vão viajar com você e dividir a conta?\n");
    scanf("%d", &pessoas);
    
    float valor = (distancia / kmL) * gasolina;
    float valorDiv = valor / pessoas;
    
    printf("O valor gasco com gasolina na viagem deu R$%.2f por pessoa", valorDiv);

    return 0;
}
