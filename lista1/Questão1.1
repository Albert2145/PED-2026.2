#include <stdio.h>
#include <stdlib.h>
#include <math.h>

int main()
{
    //Questão 1
    int a;
    int b;
    printf("Digite o valor do primeiro número.\n");
    scanf("%d", &a);
    printf("Digite o valor do segundo número.\n");
    scanf("%d", &b);
    int soma = a + b;
    printf("A soma de %d + %d dá %d.\n", a, b, soma);
     
    return 0;
}
