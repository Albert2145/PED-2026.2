#include <stdio.h>
int main()
{
    //Questao 2.2
    float num;

    printf("Informe um numero.\n");
    scanf("%f", &num);

    if (num > 0){
        printf("O numero é positivo");
    }
    else if (num < 0) {
        printf("O numero é negativo");
    }
    else {
        printf("O numero é zero");
    }

    return 0;
}
