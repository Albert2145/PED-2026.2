#include <stdio.h>
#include <stdlib.h>

    //Questao 4.1
int maior(int a, int b, int c){
   
    if(a >= b && a >= c){
        return a;
    }
    else if(b >= a && b >= c){
        return b;
    }
    else if(c >= a && c >= b){
        return c;
    }
    
}

int main(){

int a, b, c;

printf("Informe três valores inteiros: ");
scanf("%d %d %d", &a, &b, &c);
printf("O maior numero é %d.\n", maior(a, b, c));

    return 0;
}
