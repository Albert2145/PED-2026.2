#include <stdio.h>
#include <stdlib.h>

    //Questao 4.2
void maior(int a, int b, int c){
   
    if(a == b && a == c){
        printf("Os numeros são iguais.\n");
    }
    else if(a >= b && a >= c){
        printf("O maior numero é %d.\n", a);
    }
    else if(b >= a && b >= c){
        printf("O maior numero é %d.\n", b);
    }
    else if(c >= a && c >= b){
        printf("O maior numero é %d.\n", c);
    }
    
}

int main(){

int a, b, c;

printf("Informe três valores inteiros: ");
scanf("%d %d %d", &a, &b, &c);
maior(a, b, c);

    return 0;
}
