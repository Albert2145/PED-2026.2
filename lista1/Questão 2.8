#include <stdio.h>
#include <math.h>
int main()
{
    //Questao 2.8
    float a, b, result;
    char sinal;

    printf("Digite o primeiro número\n");
    scanf("%f", &a);

    printf("Digite a operação desejada. (+, -, *, /)\n");
    scanf(" %c", &sinal);
    
    printf("Digite o segundo número\n");
    scanf("%f", &b);

    if(sinal == '+'){
        result = a + b;
        printf("%.1f %c %.1f = %.1f", a, sinal, b, result);
    }
    else if(sinal == '-'){
        result = a - b;
        printf("%.1f %c %.1f = %.1f", a, sinal, b, result);
    }
    else if(sinal == '*'){
        result = a * b;
        printf("%.1f %c %.1f = %.1f", a, sinal, b, result);
    }
    else if(sinal == '/'){
        result = a / b;
        printf("%.1f %c %.1f = %.1f", a, sinal, b, result);
    }
    return 0;
}
