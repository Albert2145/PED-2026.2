#include <stdio.h>
#include <stdlib.h>
#define TRUE 1
#define FALSE 0

    //Questao 4.4
    int isPrimo(int a){
        for(int i = 2; i * i <= a; i++){
            if(a % i == 0){
                return 0;
            }
            else{
                return 1;
            }
        }
    }

int main(){

    for(int i = 1; i <= 100; i++){
        if(i == 1){
            continue;
        }
        if(isPrimo(i)){
            printf("%d\n", i);
        }
    }
    return 0;
}
