#include <stdio.h>
int main()
{
    //Questao 2.3
    float num1, num2, num3;

    printf("Informe tres numeros.\n");
    scanf("%f", &num1);
    scanf("%f", &num2);
    scanf("%f", &num3);

    if (num1 > num2 && num1 > num3){
        printf("O maior numero é %.1f.\n", num1);
    }
    else if (num2 > num1 && num2 > num3){
        printf("O maior numero é %.1f.\n", num2);
    }
    else if (num3 > num1 && num3 > num2){
        printf("O maior numero é %.1f.\n", num3);
    }
    else{
        printf("Os numeros são iguais.\n");
    }
    
    return 0;
}
