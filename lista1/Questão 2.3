#include <stdio.h>
int main()
{
    //Questao 2.3
    float a, b, c;

    printf("Informe tres numeros.\n");
    scanf("%f", &a);
    scanf("%f", &b);
    scanf("%f", &c);

    if(a == b && a == c){
        printf("Os numeros são iguais.\n");
    }
    else if(a >= b && a >= c){
        printf("O maior numero é %d.\n", a);
    }
    else if(b >= a && b >= c){
        printf("O maior numero é %d.\n", b);
    }
    else if(c >= a && c >= b){
        printf("O maior numero é %d.\n", c);
    }
    
    return 0;
}
