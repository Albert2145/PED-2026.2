#include <stdio.h>
int main()
{
    //Questao 2.4
    int idade;

    printf("Informe a idade.\n");
    scanf("%d", &idade);
    
    if(idade < 0){
        printf("Valor invalido");
    }
    else if(idade >= 0 && idade <= 11){
        printf("Criança");
    }
    else if(idade >= 12 && idade <= 17){
        printf("Adolescente");
    }
    else if(idade >= 18 && idade <= 59){
        printf("Adulto");
    }
    else if(idade >= 60){
        printf("Idoso");
    }
    
    return 0;
}
