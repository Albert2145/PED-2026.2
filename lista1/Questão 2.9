    int iris4_a1=444, iris4_a2=555, iris4_a3=666;
    int irisnova_a1, irisnova_a2, irisnova_a3;

    printf("Insira os tres valores da nova leitura de padrões de iris.\n");
    scanf("%d", &irisnova_a1);
    scanf("%d", &irisnova_a2);
    scanf("%d", &irisnova_a3);
    
    if ((abs(irisnova_a1 - iris1_a1) <= 5) && (abs(irisnova_a2 - iris1_a2) <= 5) && (abs(irisnova_a3 - iris1_a3) <= 5)){
        printf("Usuário 1 autenticado.");
