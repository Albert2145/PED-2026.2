#include <stdio.h>
int main(){
    //Questao 3.7
    int soma,numLidos, media, i = 0;

    while(i >= 0){
        printf("Digite um número inteiro. (Digite -1 para parar)\n");
        scanf("%d", &i);
        if(i >= 0){
            soma = soma + i;
            numLidos += 1;
            media = soma / numLidos;
        }
    }
    
    if(numLidos > 0){
        printf("Foram lidos %d números e a média é %d", numLidos, media);
    }
    else{
        printf("Não foi lido nenhum número.");
    }
    return 0;
}
