#include <stdio.h>
#include <stdlib.h>

int main()
{

    //Questão 4

    char estatico[100];

    printf("Escreve ai\n");
    scanf(" %s", estatico);
    int i = 0;
    while(estatico[i] != '\0'){
        i++;
    }

    char *dinamico;
    dinamico = (char *) malloc(i*sizeof(char));

    int j = 0;
    while(estatico[j] != '\0'){
        j++;
        *(dinamico + j-1) = estatico[j - 1];
    }
    printf("%s", dinamico);
    return 0;
}
