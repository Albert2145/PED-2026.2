#include <stdio.h>
#include <stdlib.h>

int somatorio(int n){
    if(n == 1){
        return 1;
    }
    else{
        n = n + somatorio(n -1);
        //Pilha de execução(usando 4 como exemplo);
        // 1
        // 2 + somatorio(1) --> 2 + 1 = 3
        // 3 + somatorio(2) --> 3 + 3 = 6
        // 4 + somatorio(3) --> 4 + 6 = 10
    }
    return n;
}

int main(){

    //Questão 1.1

    int n;
    printf("Digite um número para que seja feito o somatório.\n");
    scanf("%d", &n);

    printf("%d", somatorio(n));
    return 0;
}
