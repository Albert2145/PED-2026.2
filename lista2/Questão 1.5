#include <stdio.h>
#include <stdlib.h>

long long int contaDigitos(long long int n){
    if(n < 10){
        return n;
    }
    else{
        n = contaDigitos(n / 10) + n % 10;
        //Pilha de execução(usando 987654 como exemplo);
        // 9
        // contaDigitos(9) + 8 --> 9 + 8 = 17
        // contaDigitos(98) + 7 --> 17 + 7 = 24
        // contaDigitos(987) + 6 --> 24 + 6 = 30
        // contaDigitos(9876) + 5 --> 30 + 5 = 35
        // contaDigitos(98765) + 4 --> 35 + 4 = 39
    }
    return n;
}

int main(){

    //Questão 1.5

    long long int n;
    printf("Digite um número.\n");
    scanf("%lld", &n);

    printf("%lld", contaDigitos(n));
    return 0;
}
