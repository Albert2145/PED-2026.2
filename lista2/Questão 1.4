#include <stdio.h>
#include <stdlib.h>

long long int contaDigitos(long long int n){
    if(n < 10){
        return 1;
    }
    else{
        n = contaDigitos(n / 10) + 1;
        //Pilha de execução(usando 987654 como exemplo);
        // 1
        // contaDigitos(9) + 1 --> 1 + 1 = 2
        // contaDigitos(98) + 1 --> 2 + 1 = 3
        // contaDigitos(987) + 1 --> 3 + 1 = 4
        // contaDigitos(9876) + 1 --> 4 + 1 = 5
        // contaDigitos(98765) + 1 --> 5 + 1 = 6
    }
    return n;
}

int main(){

    //Questão 1.4

    long long int n;
    printf("Digite um número.\n");
    scanf("%lld", &n);

    printf("%lld", contaDigitos(n));
    return 0;
}
