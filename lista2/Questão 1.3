#include <stdio.h>
#include <stdlib.h>

long long int nesimo(long long int n){
    if(n == 1){
        return 1;
    }
    else{
        n = nesimo(n - 1) * 3;
        //Pilha de execução(usando 6 como exemplo);
        // 1
        // nesimo(1) * 3 --> 1 * 3 = 3
        // nesimo(2) * 3 --> 3 * 3 = 9
        // nesimo(3) * 3 --> 9 * 3 = 27
        // nesimo(4) * 3 --> 27 * 3 = 81
        // nesimo(5) * 3 --> 81 * 3 = 243
    }
    return n;
}

int main(){

    //Questão 1.3

    int n;
    printf("Digite um número.\n");
    scanf("%d", &n);

    printf("%lld", nesimo(n));
    return 0;
}
