#include <stdio.h>
#include <stdlib.h>

#define true 1
#define false 0

// f("arara", 2, 2) --> true
// f("arara", 1, 3) --> f("arara", 2, 2)
// f("arara", 0, 4) --> f("arara", 1, 3)

// f("osso", 2, 1) --> 
// f("osso", 1, 2) --> f("osso", 2, 1)
// f("osso", 0, 3) --> f("osso", 1, 2)

int isPalindromo(char palavra[], int inicio, int fim){
    printf("%s %d %d\n", palavra, inicio, fim);
    //caso base: a palavra só tem uma letra
    if(inicio >= fim){
        return true;
    }
    else if(palavra[inicio] == palavra[fim]){
        return isPalindromo(palavra, inicio + 1, fim - 1);
    }
    else{
        return false;
    }
}

int main(){

    //Questão 1.8
    char palavra[20];
    int inicio, fim;

   printf("Informe uma palavra, 0 para o inicio e um número para o fim(contando a partir do 0).\n");
   scanf("%s %d %d", &palavra, &inicio, &fim);

   if(isPalindromo){
    printf("É palindromo");
   }
   else{
    printf("Não é palindromo");
   }

    return 0;
}
