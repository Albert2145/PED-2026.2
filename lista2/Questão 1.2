#include <stdio.h>
#include <stdlib.h>

int fat(int n){
    if(n == 1){
        return 1;
    }
    else{
        n = n * fat(n -1);
        //Pilha de execução(usando 4 como exemplo);
        // 1
        // 2 * fat(1) --> 2 * 1 = 2
        // 3 * fat(2) --> 3 * 3 = 9
        // 4 * fat(3) --> 4 * 6 = 24
    }
    return n;
}

int main(){

    //Questão 1.2

    int n;
    printf("Digite um número para que seja feito o somatório.\n");
    scanf("%d", &n);

    printf("%d", fat(n));
    return 0;
}
