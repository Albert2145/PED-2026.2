#include <stdio.h>
#include <stdlib.h>

void dec2bin(int n){
    if(n < 2){
        printf("%d", n);
        return;
    }
    else{
        dec2bin(n / 2);
        printf("%d", n % 2);
        //Pilha de execução(O mesmo exemplo da lista, o 13)
        // 1 < 2 --> print 1 e para a recursão
        // 3 / 2 = 1 resto 1 --> print 1
        // 6 / 2 = 3 restp 0 --> print 0
        // 13 / 2 = 6 resto 1 --> print 1
    }
}

int main(){

    //Questão 1.9

    int n;

    printf("Digite um ineiro não negativo e ele será convertido para decimal\n");
    scanf("%d", &n);

    if(n >= 0){
        dec2bin(n);
    }
    else{
        printf("O número não pode ser negativo");
    }
    return 0;
}
